{
  "app-id": "io.github.hdijkema.AltPgAdmin",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "26.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "pgadmin-jr",
  "finish-args": [
    "--share=ipc",
    "--share=network",
    "--filesystem=host",
    "--filesystem=/run/postgresql",
    "--talk-name=org.freedesktop.secrets",
    "--socket=x11"
  ],
  "cleanup": [
    "/include",
    "/lib/*.a",
    "/lib/cmake",
    "/lib/pkgconfig",
    "/share/man",
    "/mkspecs"
  ],
  "modules": [
    {
      "name": "libsecret",
      "buildsystem": "meson",
      "config-opts": [
        "-Dmanpage=false",
        "-Dgtk_doc=false",
        "-Dintrospection=false",
        "-Dvapi=false",
        "-Dcrypto=gnutls",
        "-Dbash_completion=disabled"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/GNOME/libsecret.git",
          "tag": "0.21.7"
        }
      ]
    },
    {
      "name": "postgresql-client",
      "buildsystem": "simple",
      "build-commands": [
        "./configure --prefix=/app --with-ssl=openssl --without-readline --without-icu --with-lz4 --with-zstd",
        "make -j${FLATPAK_BUILDER_N_JOBS}",
        "make -C src/interfaces/libpq install",
        "make -C src/include install",
        "make -C src/bin/pg_config install",
        "make -C src/bin/pg_dump install",
        "make -C src/bin/psql install",
        "make -C src/bin/scripts install",
        "install -Dm644 COPYRIGHT /app/share/doc/postgresql/COPYRIGHT"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://ftp.postgresql.org/pub/source/v18.6/postgresql-18.6.tar.bz2",
          "sha256": "555610c24d53e4316da5b7d3fc25c279d96856d5e0e23ee308c328c5fa881d9f"
        }
      ]
    },
    {
      "name": "pgadmin-jr",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DPGADM_FLTK_TESTS=OFF",
        "-DFLTK_BACKEND_WAYLAND=OFF",
        "-DFETCHCONTENT_FULLY_DISCONNECTED=ON",
        "-DPGADM_FLTK_CELL_SOURCE_DIR=/run/build/pgadmin-jr/vendor/fltk-cell",
        "-DFLTK_CELL_CSS_SOURCE_DIR=/run/build/pgadmin-jr/vendor/fltk-css",
        "-DFETCHCONTENT_SOURCE_DIR_FLTK=/run/build/pgadmin-jr/vendor/fltk",
        "-DFETCHCONTENT_SOURCE_DIR_FLTK_JSON=/run/build/pgadmin-jr/vendor/json",
        "-DFETCHCONTENT_SOURCE_DIR_FLTK_KEYCHAIN=/run/build/pgadmin-jr/vendor/keychain",
        "-DFETCHCONTENT_SOURCE_DIR_ZLIB=/run/build/pgadmin-jr/vendor/zlib",
        "-DFETCHCONTENT_SOURCE_DIR_LIBXLSXWRITER=/run/build/pgadmin-jr/vendor/libxlsxwriter"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../..",
          "skip": [
            ".git",
            "build",
            "dist",
            ".flatpak-builder",
            "third_party",
            "downloads",
            "CMakeLists.txt.user"
          ]
        },
        {
          "type": "archive",
          "url": "https://github.com/madler/zlib/archive/refs/tags/v1.3.2.tar.gz",
          "sha256": "b99a0b86c0ba9360ec7e78c4f1e43b1cbdf1e6936c8fa0f6835c0cd694a495a1",
          "dest": "vendor/zlib"
        },
        {
          "type": "archive",
          "url": "https://github.com/jmcnamara/libxlsxwriter/archive/refs/tags/v1.2.4.tar.gz",
          "sha256": "e0db59fc248a5ffa465a05ea83a9d466d4bca0e53ab42771515d4ebb467a41c1",
          "dest": "vendor/libxlsxwriter"
        },
        {
          "type": "git",
          "url": "https://github.com/fltk/fltk.git",
          "tag": "release-1.4.5",
          "dest": "vendor/fltk"
        },
        {
          "type": "git",
          "url": "https://github.com/hdijkema/fltk-css.git",
          "tag": "v0.1.0",
          "dest": "vendor/fltk-css"
        },
        {
          "type": "git",
          "url": "https://github.com/hdijkema/fltk-cell.git",
          "tag": "v0.1.0",
          "dest": "vendor/fltk-cell"
        },
        {
          "type": "git",
          "url": "https://github.com/nlohmann/json.git",
          "tag": "v3.12.0",
          "dest": "vendor/json"
        },
        {
          "type": "git",
          "url": "https://github.com/hrantzsch/keychain.git",
          "tag": "v1.3.1",
          "dest": "vendor/keychain"
        }
      ],
      "no-make-install": true,
      "post-install": [
        "cmake --install . --component Runtime"
      ]
    }
  ]
}
