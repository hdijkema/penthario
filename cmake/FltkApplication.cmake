set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
# CMake otherwise permits a Release executable to silently use a Debug-only SDK.
# FLTK's Debug WinMain opens a console, and its runtime may also be incompatible.
if(MSVC)
    foreach(config RELEASE RELWITHDEBINFO MINSIZEREL)
        set(CMAKE_MAP_IMPORTED_CONFIG_${config} "Release;RelWithDebInfo;MinSizeRel")
    endforeach()
endif()
include(FetchContent)
include(GNUInstallDirs)
if(APPLE)
    enable_language(OBJCXX)
endif()
option(PGADM_FLTK_TESTS "Build native backend tests" ON)
option(PGADM_FLTK_UI_TESTS "Build local interactive UI tests (requires a desktop)" ON)
# Load an installed SDK once in the parent scope, so all widget libraries share
# the same imported targets and configuration mapping.
find_package(FLTK 1.4.5 CONFIG QUIET)
if(MSVC AND TARGET fltk::fltk AND CMAKE_BUILD_TYPE MATCHES "^(Release|RelWithDebInfo|MinSizeRel)$")
    get_target_property(fltk_imported fltk::fltk IMPORTED)
    if(fltk_imported)
        get_target_property(fltk_configs fltk::fltk IMPORTED_CONFIGURATIONS)
        if(NOT fltk_configs MATCHES "(RELEASE|RELWITHDEBINFO|MINSIZEREL)")
            message(FATAL_ERROR "A Release build requires a Release FLTK SDK. FLTK_DIR=${FLTK_DIR} only provides ${fltk_configs}. Install a matching SDK or use FLTK release sources.")
        endif()
    endif()
endif()
set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
set(BUILD_TESTING OFF CACHE BOOL "" FORCE)
set(FLTK_CELL_BUILD_EXAMPLE OFF CACHE BOOL "" FORCE)
set(FLTK_CELL_WITH_CSS ON CACHE BOOL "" FORCE)
set(FLTK_CSS_BUILD_EXAMPLE OFF CACHE BOOL "" FORCE)
# The application uses native styling from fltk-css 0.1.1. Load it before
# fltk-cell, which reuses an existing stylesheet target.
set(FLTK_CELL_CSS_SOURCE_DIR "" CACHE PATH "Optional development fltk-css checkout; empty uses release v0.1.1")
if(FLTK_CELL_CSS_SOURCE_DIR)
    if(NOT EXISTS "${FLTK_CELL_CSS_SOURCE_DIR}/CMakeLists.txt")
        message(FATAL_ERROR "FLTK_CELL_CSS_SOURCE_DIR must point to a fltk-css checkout")
    endif()
    add_subdirectory("${FLTK_CELL_CSS_SOURCE_DIR}" "${CMAKE_CURRENT_BINARY_DIR}/css")
else()
    find_package(fltk-css 0.1.1 CONFIG QUIET)
    if(NOT TARGET fltk-css::fltk-css)
        set(FLTK_CSS_BUILD_EXAMPLE OFF CACHE BOOL "" FORCE)
        FetchContent_Declare(pgadm_css GIT_REPOSITORY https://github.com/hdijkema/fltk-css.git GIT_TAG v0.1.1 GIT_SHALLOW TRUE)
        FetchContent_MakeAvailable(pgadm_css)
    endif()
endif()
set(PGADM_FLTK_CELL_SOURCE_DIR "" CACHE PATH "Optional development fltk-cell checkout; empty uses release v0.1.0")
if(PGADM_FLTK_CELL_SOURCE_DIR)
    if(NOT EXISTS "${PGADM_FLTK_CELL_SOURCE_DIR}/CMakeLists.txt")
        message(FATAL_ERROR "PGADM_FLTK_CELL_SOURCE_DIR must point to a fltk-cell checkout")
    endif()
    add_subdirectory("${PGADM_FLTK_CELL_SOURCE_DIR}" "${CMAKE_CURRENT_BINARY_DIR}/cell")
else()
    find_package(fltk-cell 0.1 CONFIG QUIET COMPONENTS css)
    if(NOT TARGET fltk-cell::css)
        FetchContent_Declare(pgadm_cell GIT_REPOSITORY https://github.com/hdijkema/fltk-cell.git GIT_TAG v0.1.0 GIT_SHALLOW TRUE)
        FetchContent_MakeAvailable(pgadm_cell)
    endif()
endif()
set(PGADM_FLTK_DOCK_SOURCE_DIR "" CACHE PATH "Optional development fltk-dock checkout; empty uses release v0.1.0")
set(FLTK_DOCK_BUILD_EXAMPLE OFF CACHE BOOL "" FORCE)
set(FLTK_DOCK_BUILD_TESTS OFF CACHE BOOL "" FORCE)
if(PGADM_FLTK_DOCK_SOURCE_DIR)
    if(NOT EXISTS "${PGADM_FLTK_DOCK_SOURCE_DIR}/CMakeLists.txt")
        message(FATAL_ERROR "PGADM_FLTK_DOCK_SOURCE_DIR must point to a fltk-dock checkout")
    endif()
    add_subdirectory("${PGADM_FLTK_DOCK_SOURCE_DIR}" "${CMAKE_CURRENT_BINARY_DIR}/dock")
else()
    find_package(fltk-dock 0.1 CONFIG QUIET)
    if(NOT TARGET fltk-dock::fltk-dock)
        FetchContent_Declare(pgadm_dock GIT_REPOSITORY https://github.com/hdijkema/fltk-dock.git GIT_TAG v0.1.0 GIT_SHALLOW TRUE)
        FetchContent_MakeAvailable(pgadm_dock)
    endif()
endif()
set(PGADM_FLTK_TOOLBAR_SOURCE_DIR "" CACHE PATH "Optional development fltk-toolbar checkout; empty uses release v0.1.1")
set(FLTK_TOOLBAR_BUILD_EXAMPLE OFF CACHE BOOL "" FORCE)
set(FLTK_TOOLBAR_BUILD_TESTS OFF CACHE BOOL "" FORCE)
if(PGADM_FLTK_TOOLBAR_SOURCE_DIR)
    if(NOT EXISTS "${PGADM_FLTK_TOOLBAR_SOURCE_DIR}/CMakeLists.txt")
        message(FATAL_ERROR "PGADM_FLTK_TOOLBAR_SOURCE_DIR must point to a fltk-toolbar checkout")
    endif()
    add_subdirectory("${PGADM_FLTK_TOOLBAR_SOURCE_DIR}" "${CMAKE_CURRENT_BINARY_DIR}/toolbar")
else()
    find_package(fltk-toolbar 0.1.1 CONFIG QUIET)
    if(NOT TARGET fltk-toolbar::fltk-toolbar)
        FetchContent_Declare(pgadm_toolbar GIT_REPOSITORY https://github.com/hdijkema/fltk-toolbar.git GIT_TAG v0.1.1 GIT_SHALLOW TRUE)
        FetchContent_MakeAvailable(pgadm_toolbar)
    endif()
endif()
set(PGADM_POSTGRESQL_ROOT "${CMAKE_CURRENT_SOURCE_DIR}/third_party/postgresql18/pgsql" CACHE PATH "PostgreSQL client SDK")
if(WIN32)
    set(PostgreSQL_INCLUDE_DIR "${PGADM_POSTGRESQL_ROOT}/include" CACHE PATH "" FORCE)
    set(PostgreSQL_LIBRARY_RELEASE "${PGADM_POSTGRESQL_ROOT}/lib/libpq.lib" CACHE FILEPATH "" FORCE)
endif()
find_package(PostgreSQL 15 REQUIRED)
find_package(Threads REQUIRED)
set(JSON_BuildTests OFF CACHE BOOL "" FORCE)
FetchContent_Declare(fltk_json GIT_REPOSITORY https://github.com/nlohmann/json.git GIT_TAG v3.12.0 GIT_SHALLOW TRUE)
FetchContent_Declare(fltk_keychain GIT_REPOSITORY https://github.com/hrantzsch/keychain.git GIT_TAG v1.3.1 GIT_SHALLOW TRUE)
set(BUILD_TESTS OFF CACHE BOOL "" FORCE)
FetchContent_MakeAvailable(fltk_json fltk_keychain)
include(cmake/Xlsx.cmake)
add_library(pgadmin-fltk-core STATIC src/fltk/core.cpp src/fltk/session.cpp src/fltk/xlsx_writer.cpp src/fltk/tool_job.cpp src/fltk/admin_sql.cpp src/fltk/query_library.cpp src/fltk/legacy_workspace.cpp)
target_include_directories(pgadmin-fltk-core PUBLIC src/fltk)
target_link_libraries(pgadmin-fltk-core PUBLIC PostgreSQL::PostgreSQL nlohmann_json::nlohmann_json Threads::Threads keychain PRIVATE xlsxwriter)
set(PGADM_UI_SOURCES src/fltk/window_state.cpp src/fltk/theme.cpp src/fltk/window.cpp src/fltk/result_table.cpp src/fltk/admin_dialogs.cpp src/fltk/sql_editor.cpp src/fltk/library_ui.cpp src/fltk/i18n.cpp)
add_executable(pgadmin-jr-fltk src/fltk/main.cpp ${PGADM_UI_SOURCES})
set_target_properties(pgadmin-jr-fltk PROPERTIES OUTPUT_NAME pgadmin-jr)
target_include_directories(pgadmin-jr-fltk PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/generated")
file(READ "${CMAKE_CURRENT_SOURCE_DIR}/assets/icons/pgadmin-jr.svg" PGADM_SVG)
file(READ "${CMAKE_CURRENT_SOURCE_DIR}/assets/icons/plug-zap.svg" PGADM_ICON_CONNECT)
file(READ "${CMAKE_CURRENT_SOURCE_DIR}/assets/icons/server-cog.svg" PGADM_ICON_PROFILE)
file(READ "${CMAKE_CURRENT_SOURCE_DIR}/assets/icons/file-plus-2.svg" PGADM_ICON_NEW)
file(READ "${CMAKE_CURRENT_SOURCE_DIR}/assets/icons/play.svg" PGADM_ICON_RUN)
file(READ "${CMAKE_CURRENT_SOURCE_DIR}/assets/icons/square.svg" PGADM_ICON_CANCEL)
configure_file(src/fltk/assets.h.in generated/assets.h @ONLY)
foreach(theme light dark classic)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/assets/themes/${theme}.css")
    string(TOUPPER "${theme}" theme_upper)
    file(READ "${CMAKE_CURRENT_SOURCE_DIR}/assets/themes/${theme}.css" PGADM_THEME_${theme_upper})
endforeach()
configure_file(src/fltk/themes.h.in generated/themes.h @ONLY)
file(READ "${CMAKE_CURRENT_SOURCE_DIR}/translations/fltk-ui.json" PGADM_UI_CATALOG)
# MSVC limits each string literal to 16 KiB. Keep the readable JSON catalog,
# but embed its lines as adjacent literals rather than one growing raw literal.
string(REPLACE "\n" "\n)PGJRCATALOG\"\nR\"PGJRCATALOG(" PGADM_UI_CATALOG "${PGADM_UI_CATALOG}")
configure_file(src/fltk/ui_catalog.h.in generated/ui_catalog.h @ONLY)
target_compile_definitions(pgadmin-jr-fltk PRIVATE PGADM_APP_VERSION="${PROJECT_VERSION}")
target_link_libraries(pgadmin-jr-fltk PRIVATE pgadmin-fltk-core fltk-cell::fltk-cell fltk-css::fltk-css fltk-dock::fltk-dock fltk-toolbar::fltk-toolbar)
if(MSVC)
    target_compile_definitions(pgadmin-fltk-core PUBLIC NOMINMAX _CRT_SECURE_NO_WARNINGS)
    target_compile_options(pgadmin-fltk-core PRIVATE /utf-8 /W4)
    target_compile_options(pgadmin-jr-fltk PRIVATE /utf-8 /W4)
    target_link_libraries(pgadmin-fltk-core PRIVATE Advapi32)
endif()
if(WIN32)
    enable_language(RC)
    set_target_properties(pgadmin-jr-fltk PROPERTIES WIN32_EXECUTABLE TRUE)
    configure_file(assets/app-icon.rc.in "${CMAKE_CURRENT_BINARY_DIR}/app-icon.rc" @ONLY)
    target_sources(pgadmin-jr-fltk PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/app-icon.rc")
    foreach(runtime libpq.dll libssl-3-x64.dll libcrypto-3-x64.dll libintl-9.dll libiconv-2.dll libwinpthread-1.dll
            liblz4.dll libzstd.dll pg_dump.exe pg_restore.exe psql.exe createdb.exe dropdb.exe)
        add_custom_command(TARGET pgadmin-jr-fltk POST_BUILD COMMAND ${CMAKE_COMMAND} -E copy_if_different
            "${PGADM_POSTGRESQL_ROOT}/bin/${runtime}" "$<TARGET_FILE_DIR:pgadmin-jr-fltk>")
    endforeach()
    foreach(notice server_license.txt commandlinetools_3rd_party_licenses.txt)
        add_custom_command(TARGET pgadmin-jr-fltk POST_BUILD COMMAND ${CMAKE_COMMAND} -E copy_if_different "${PGADM_POSTGRESQL_ROOT}/${notice}" "$<TARGET_FILE_DIR:pgadmin-jr-fltk>")
    endforeach()
endif()
if(APPLE)
    set_target_properties(pgadmin-jr-fltk PROPERTIES MACOSX_BUNDLE TRUE
        MACOSX_BUNDLE_BUNDLE_NAME pgadmin-jr MACOSX_BUNDLE_GUI_IDENTIFIER io.github.hdijkema.AltPgAdmin
        MACOSX_BUNDLE_BUNDLE_VERSION "${PROJECT_VERSION}" MACOSX_BUNDLE_SHORT_VERSION_STRING "${PROJECT_VERSION}"
        MACOSX_BUNDLE_ICON_FILE pgadmin-jr.icns)
    target_sources(pgadmin-jr-fltk PRIVATE assets/icons/pgadmin-jr.icns)
    set_source_files_properties(assets/icons/pgadmin-jr.icns PROPERTIES MACOSX_PACKAGE_LOCATION Resources)
endif()
if(PGADM_FLTK_TESTS)
    enable_testing()
    add_executable(pgadmin-fltk-tests tests/fltk_core.cpp)
    target_link_libraries(pgadmin-fltk-tests PRIVATE pgadmin-fltk-core)
    target_compile_definitions(pgadmin-fltk-tests PRIVATE PGADM_SOURCE_DIR="${CMAKE_CURRENT_SOURCE_DIR}")
    if(MSVC)
        target_compile_options(pgadmin-fltk-tests PRIVATE /utf-8 /W4)
    endif()
    add_dependencies(pgadmin-fltk-tests pgadmin-jr-fltk)
    add_test(NAME fltk-core COMMAND pgadmin-fltk-tests)
    set_tests_properties(fltk-core PROPERTIES TIMEOUT 60)
    find_package(Python3 COMPONENTS Interpreter QUIET)
    if(Python3_Interpreter_FOUND)
        add_test(NAME fltk-translations COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/tests/check-translations.py")
        add_test(NAME fltk-xlsx COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/tests/check-fltk-xlsx.py" "$<TARGET_FILE:pgadmin-fltk-tests>")
        set_tests_properties(fltk-translations fltk-xlsx PROPERTIES TIMEOUT 60)
    endif()
    if(PGADM_FLTK_UI_TESTS AND (WIN32 OR UNIX))
        add_executable(pgadmin-fltk-ui-tests tests/fltk_ui.cpp ${PGADM_UI_SOURCES})
        target_include_directories(pgadmin-fltk-ui-tests PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/generated")
        target_compile_definitions(pgadmin-fltk-ui-tests PRIVATE PGADM_APP_VERSION="${PROJECT_VERSION}")
        target_link_libraries(pgadmin-fltk-ui-tests PRIVATE pgadmin-fltk-core fltk-cell::css fltk-dock::fltk-dock fltk-toolbar::fltk-toolbar)
        if(MSVC)
            target_compile_options(pgadmin-fltk-ui-tests PRIVATE /utf-8 /W4)
        endif()
        add_dependencies(pgadmin-fltk-ui-tests pgadmin-jr-fltk)
        add_test(NAME fltk-ui COMMAND pgadmin-fltk-ui-tests "${CMAKE_CURRENT_BINARY_DIR}/ui-check")
        set_tests_properties(fltk-ui PROPERTIES TIMEOUT 120)
    endif()
endif()
install(TARGETS pgadmin-jr-fltk RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR} COMPONENT Runtime BUNDLE DESTINATION . COMPONENT Runtime)
foreach(pair "${fltk_json_SOURCE_DIR}/LICENSE.MIT|nlohmann-json.txt" "${fltk_keychain_SOURCE_DIR}/LICENSE|keychain.txt" "${libxlsxwriter_SOURCE_DIR}/License.txt|libxlsxwriter-LICENSE.txt" "${zlib_SOURCE_DIR}/LICENSE|zlib-LICENSE.txt" "${CMAKE_CURRENT_SOURCE_DIR}/LICENSE|LICENSE.txt" "${CMAKE_CURRENT_SOURCE_DIR}/assets/icons/LICENSE.txt|Lucide-LICENSE.txt")
    string(REPLACE "|" ";" fields "${pair}")
    list(GET fields 0 source)
    list(GET fields 1 name)
    configure_file("${source}" "${CMAKE_CURRENT_BINARY_DIR}/notices/${name}" COPYONLY)
endforeach()
file(GLOB dependency_notices "${CMAKE_CURRENT_SOURCE_DIR}/assets/licenses/*.txt")
foreach(source IN LISTS dependency_notices)
    get_filename_component(name "${source}" NAME)
    configure_file("${source}" "${CMAKE_CURRENT_BINARY_DIR}/notices/${name}" COPYONLY)
endforeach()
file(GLOB notices "${CMAKE_CURRENT_BINARY_DIR}/notices/*")
install(FILES ${notices} DESTINATION ${CMAKE_INSTALL_DATADIR}/licenses/pgadmin-jr COMPONENT Runtime)
if(UNIX AND NOT APPLE)
    include(cmake/FltkLinuxPackaging.cmake)
endif()
