set(PGADM_DESKTOP_ID io.github.hdijkema.AltPgAdmin)
install(FILES "packaging/linux/${PGADM_DESKTOP_ID}.desktop" DESTINATION ${CMAKE_INSTALL_DATADIR}/applications COMPONENT Runtime)
install(FILES assets/icons/penthario.svg DESTINATION ${CMAKE_INSTALL_DATADIR}/icons/hicolor/scalable/apps RENAME "${PGADM_DESKTOP_ID}.svg" COMPONENT Runtime)
install(FILES "packaging/linux/${PGADM_DESKTOP_ID}.metainfo.xml" DESTINATION ${CMAKE_INSTALL_DATADIR}/metainfo COMPONENT Runtime)
set(CPACK_GENERATOR DEB)
set(CPACK_PACKAGE_NAME penthario)
set(CPACK_PACKAGE_VENDOR "Penthario contributors")
set(CPACK_PACKAGE_CONTACT "Penthario maintainers <hdijkema@users.noreply.github.com>")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "Native PostgreSQL administration application")
set(CPACK_PACKAGE_HOMEPAGE_URL "https://github.com/hdijkema/penthario")
set(CPACK_PACKAGE_VERSION "${PROJECT_VERSION}")
set(CPACK_PACKAGING_INSTALL_PREFIX /usr)
set(CPACK_STRIP_FILES ON)
set(CPACK_COMPONENTS_ALL Runtime)
set(CPACK_DEB_COMPONENT_INSTALL ON)
set(CPACK_DEBIAN_RUNTIME_PACKAGE_NAME penthario)
set(CPACK_DEBIAN_PACKAGE_REPLACES "pgadmin-jr, alt-pg-admin")
set(CPACK_DEBIAN_PACKAGE_CONFLICTS "pgadmin-jr, alt-pg-admin")
set(CPACK_DEBIAN_PACKAGE_SECTION database)
set(CPACK_DEBIAN_PACKAGE_PRIORITY optional)
set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS ON)
set(CPACK_DEBIAN_PACKAGE_DEPENDS "libpq5 (>= 15), libsecret-1-0, postgresql-client")
set(PGADM_DEBIAN_VERSION "" CACHE STRING "Debian version for package filename")
if(PGADM_DEBIAN_VERSION)
    if(NOT PGADM_DEBIAN_VERSION MATCHES "^[0-9]+$")
        message(FATAL_ERROR "PGADM_DEBIAN_VERSION must be numeric")
    endif()
    execute_process(COMMAND dpkg --print-architecture OUTPUT_VARIABLE arch OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
    set(CPACK_DEBIAN_RUNTIME_FILE_NAME "penthario_${PROJECT_VERSION}-debian${PGADM_DEBIAN_VERSION}_${arch}.deb")
else()
    set(CPACK_DEBIAN_RUNTIME_FILE_NAME DEB-DEFAULT)
endif()
include(CPack)
